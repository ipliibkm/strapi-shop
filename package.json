{
  "name": "openshopfront-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/admin",
    "apps/storefront",
    "packages/ui",
    "apps/setup"
  ],
  "scripts": {
    "format": "npm run format:frontend && npm run format:backend",
    "format:check": "npm run format:frontend:check && npm run format:backend:check",
    "format:frontend": "prettier --write \"{apps/admin,apps/setup,apps/storefront,packages/ui}/**/*.{ts,html,css,scss,json}\" \"apps/cms/{config,src}/**/*.{js,ts,json}\" \"apps/cms/package.json\" \"*.{json,js,mjs,cjs}\"",
    "format:frontend:check": "prettier --check \"{apps/admin,apps/setup,apps/storefront,packages/ui}/**/*.{ts,html,css,scss,json}\" \"apps/cms/{config,src}/**/*.{js,ts,json}\" \"apps/cms/package.json\" \"*.{json,js,mjs,cjs}\"",
    "format:backend": "mvn -f apps/backend/pom.xml spotless:apply",
    "format:backend:check": "mvn -f apps/backend/pom.xml spotless:check",
    "start:admin": "ng serve admin",
    "start:storefront": "ng serve storefront",
    "build:admin": "ng build admin",
    "build:storefront": "ng build storefront",
    "test": "ng test",
    "start:setup": "ng serve setup",
    "build:setup": "ng build setup",
    "storybook": "ng run admin:storybook",
    "build-storybook": "ng run admin:build-storybook"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/angular": "^10.6.3",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.8.3",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "material-symbols": "^0.48.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.0"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "serialize-javascript": "7.1.3",
    "vite": "8.3.5",
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "7.4.5"
    }
  }
}
