# Copy this file to a local untracked file and replace the validation values.
STOREFRONT_HOST=storefront.localhost
ADMIN_HOST=admin.localhost
CMS_HOST=cms.localhost
STORYBOOK_HOST=storybook.localhost
HTTP_PORT=80
HTTPS_PORT=443
PLATFORM_ADMIN_BASE_URL=http://admin.localhost
PLATFORM_STOREFRONT_BASE_URL=http://storefront.localhost
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
PLATFORM_SETUP_ENABLED=true
TRAEFIK_CMS_ENABLED=true
TRAEFIK_STORYBOOK_ENABLED=true
TRAEFIK_CERT_RESOLVER=
TRAEFIK_HTTP_MIDDLEWARES=security-headers@file
TRAEFIK_HTTPS_MIDDLEWARES=security-headers@file
TRAEFIK_DYNAMIC_CONFIG=./infrastructure/traefik/dynamic/development.yaml
POSTGRES_PASSWORD=DEVELOPMENT_ONLY_POSTGRES_PASSWORD
CMS_DB_PASSWORD=DEVELOPMENT_ONLY_CMS_PASSWORD
PLATFORM_SETUP_TOKEN=DEVELOPMENT_ONLY_SETUP_TOKEN_32_CHARS
STRAPI_APP_KEYS=DEVELOPMENT_ONLY_1,DEVELOPMENT_ONLY_2,DEVELOPMENT_ONLY_3,DEVELOPMENT_ONLY_4
STRAPI_API_TOKEN_SALT=DEVELOPMENT_ONLY_API_TOKEN_SALT
STRAPI_ADMIN_JWT_SECRET=DEVELOPMENT_ONLY_ADMIN_JWT_SECRET
STRAPI_JWT_SECRET=DEVELOPMENT_ONLY_JWT_SECRET
STRAPI_TRANSFER_TOKEN_SALT=DEVELOPMENT_ONLY_TRANSFER_TOKEN_SALT
STRAPI_ENCRYPTION_KEY=DEVELOPMENT_ONLY_ENCRYPTION_KEY
PLATFORM_STRAPI_TOKEN_ENCRYPTION_KEY=DEVELOPMENT_ONLY_TOKEN_ENCRYPTION_KEY
