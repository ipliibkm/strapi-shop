# Use these values only to validate the production Compose configuration.
# Supply real production values from the approved secret manager.
STOREFRONT_HOST=shop.example.com
ADMIN_HOST=admin.example.com
CMS_HOST=cms.invalid
STORYBOOK_HOST=storybook.invalid
HTTP_PORT=80
HTTPS_PORT=443
PLATFORM_ADMIN_BASE_URL=https://admin.example.com
PLATFORM_STOREFRONT_BASE_URL=https://shop.example.com
SERVER_SERVLET_SESSION_COOKIE_SECURE=true
PLATFORM_SETUP_ENABLED=false
TRAEFIK_CMS_ENABLED=false
TRAEFIK_STORYBOOK_ENABLED=false
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_HTTP_MIDDLEWARES=https-redirect@file
TRAEFIK_HTTPS_MIDDLEWARES=security-headers@file
TRAEFIK_DYNAMIC_CONFIG=./infrastructure/traefik/dynamic/production.yaml
ACME_EMAIL=operations@example.com
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
POSTGRES_PASSWORD=VALIDATION_ONLY_POSTGRES_PASSWORD
CMS_DB_PASSWORD=VALIDATION_ONLY_CMS_PASSWORD
PLATFORM_SETUP_TOKEN=VALIDATION_ONLY_SETUP_TOKEN_32_CHARS
STRAPI_APP_KEYS=VALIDATION_ONLY_1,VALIDATION_ONLY_2,VALIDATION_ONLY_3,VALIDATION_ONLY_4
STRAPI_API_TOKEN_SALT=VALIDATION_ONLY_API_TOKEN_SALT
STRAPI_ADMIN_JWT_SECRET=VALIDATION_ONLY_ADMIN_JWT_SECRET
STRAPI_JWT_SECRET=VALIDATION_ONLY_JWT_SECRET
STRAPI_TRANSFER_TOKEN_SALT=VALIDATION_ONLY_TRANSFER_TOKEN_SALT
STRAPI_ENCRYPTION_KEY=VALIDATION_ONLY_ENCRYPTION_KEY
PLATFORM_STRAPI_TOKEN_ENCRYPTION_KEY=VALIDATION_ONLY_TOKEN_ENCRYPTION_KEY
