# Development-only examples; generate production secrets externally.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
CMS_DB_PASSWORD=REPLACE_WITH_SEPARATE_LONG_RANDOM_PASSWORD
STRAPI_APP_KEYS=REPLACE1,REPLACE2,REPLACE3,REPLACE4
STRAPI_API_TOKEN_SALT=REPLACE_WITH_RANDOM
STRAPI_ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM
STRAPI_JWT_SECRET=REPLACE_WITH_RANDOM
STRAPI_TRANSFER_TOKEN_SALT=REPLACE_WITH_RANDOM
STRAPI_ENCRYPTION_KEY=REPLACE_WITH_RANDOM
# Google OAuth / Stripe are disabled until configured; never commit actual credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLATFORM_OAUTH_TOKEN_ENCRYPTION_KEY=
PLATFORM_GOOGLE_ENABLED=false
# Must match the registered Google redirect URI; Google Cloud rejects admin.localhost:
PLATFORM_ADMIN_BASE_URL=http://localhost
PLATFORM_STRAPI_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
# Long-lived Strapi API token (full-access) used by anonymous form submissions.
STRAPI_SERVICE_TOKEN=REPLACE_WITH_STRAPI_API_TOKEN
PLATFORM_GOOGLE_SYNC_INTERVAL_MS=60000
PLATFORM_GOOGLE_SYNC_INITIAL_LOOKBACK_DAYS=31
PLATFORM_GOOGLE_DELIVERY_INTERVAL_MS=15000
PLATFORM_BOOKING_PUBLIC_RESOURCE_ID=default
PLATFORM_BOOKING_MAXIMUM_CALENDAR_SYNC_AGE_SECONDS=300
PLATFORM_ADMIN_SESSION_TIMEOUT=8h
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
PLATFORM_STOREFRONT_BASE_URL=http://storefront.localhost
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_COMMERCE_EXPIRY_INTERVAL_MS=60000
# Optional SMTP provider for form and order mail. Leave MAIL_HOST empty to send
# through the connected Google account (requires the gmail.send scope).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
PLATFORM_MAIL_FROM_ADDRESS=
